rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function owner() {
      return request.auth != null && request.auth.token.email_verified == true
        && email() in ['luke@totalwelding.com.au'];
    }
    function members() {
      return get(/databases/$(database)/documents/access/members).data.members;
    }
    function member() {
      return request.auth != null && (owner() || email() in members());
    }
    function manager() {
      return owner() || (member() && members()[email()].role == 'manager');
    }

    // Who's on the crew: everyone on it can read, only managers change it
    match /access/members {
      allow read: if member();
      allow write: if manager();
    }
    // People asking to join: they write their own request, managers see and clear them
    match /requests/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow read, delete: if manager() || (request.auth != null && request.auth.uid == uid);
    }
    // $ quotes, charge rates, labour cost: managers only
    match /money/{id} {
      allow read, write: if manager();
    }
    // Clock on/off: crew write their own, managers fix anyone's
    match /shifts/{id} {
      allow read: if member();
      allow create: if manager() || (member() && request.resource.data.email == email());
      allow update: if manager() || (member() && resource.data.email == email()
                                     && request.resource.data.email == email());
      allow delete: if manager();
    }
    // Everything else (jobs, consumables, calendar, totals): crew
    match /{col}/{rest=**} {
      allow read, write: if member() && !(col in ['access', 'requests', 'money', 'shifts']);
    }
  }
}
